generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// USER

model Users {
  id String @id @default(cuid())

  email String @unique
  password String

  name String
  role EnumUserRole? 
  socialLinks Json? @map("social_links")
  profileId String @map("profile_id")

  isVerification Boolean @default(false) @map("is_verification")
  organizationName String? @map("organization_name")
  organizationType EnumUserType? @map("organization_type")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  orders Orders[]
  events Events[]

  @@map("users")
  @@index([name, profileId])
}

model Orders {
  id String @id @default(cuid())

  userId String @map("user_id")
  eventId String @map("event_id")

  startDate DateTime @map("start_date")
  endDate DateTime @map("end_date")

  price Int
  isCompleted Boolean @default(false) @map("is_completed")

  user Users @relation(fields: [userId], references: [id], onDelete: Cascade)  
  event Events @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([userId, eventId])
  @@map("orders")
}

enum EnumUserRole {
  ADMIN
  GUIDE
  USER
}

enum EnumUserType {
  EP
  OOP
}

// EVENTS

model Events {
  id String @id @default(cuid())

  userId String @map("user_id")
  title String
  type EnumEventsType
  days Int @default(1)
  countPeople Int @default(1) @map("count_people")
  price Int
  dateEvent DateTime @map("date_event")
  description String 

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user Users @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Orders[]
  
  @@map("events")
  @@index([title])
}

enum EnumEventsType {
  GET
  SEND
}